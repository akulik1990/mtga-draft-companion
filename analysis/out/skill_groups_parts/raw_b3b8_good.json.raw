], [["tap_on per card, hi-speed tercile", "all"], [1.5924953191601412, -0.3406444111896853, 3.5256350495099675, 0.10639247869207875]], [["tap_on >= 4 dummy, Q(a)", "all"], [13.449325334180562, 4.094084427323136, 22.80456624103799, 0.004836229275667897]], [["tap_on >= 4 dummy x WALK>=4", "all"], [6.029039153459323, -10.082742843433062, 22.14082115035171, 0.4632942216617105]]], "lines": ["# B3 / B8: deck speed and enters-tapped lands (FRA Premier)\n", "## Card sets (fixed from oracle text / Scryfall before outcomes)\n", "Lands that enter tapped (class, colours):", "  ALW   Roiling Canopy           G   | This land enters tapped.", "  ALW   Room of Refuge           -   | This land enters tapped. As it enters, choose a color.", "  ALW   Theorist's Sanctum       U   | ({T}: Add {U}.)", "  PW    Dedicated Commons        RW   | This land enters tapped unless you control a planeswalker.", "  PW    Fatehold Annex           UW   | This land enters tapped unless you control a planeswalker.", "  PW    Formidable Commons       BG   | This land enters tapped unless you control a planeswalker.", "  PW    Innovative Commons       RU   | This land enters tapped unless you control a planeswalker.", "  PW    Konstrari Annex          GR   | This land enters tapped unless you control a planeswalker.", "  PW    Meticulous Commons       BW   | This land enters tapped unless you control a planeswalker.", "  PW    Stingerquill Annex       BR   | This land enters tapped unless you control a planeswalker.", "  PW    Theorix Annex            BU   | This land enters tapped unless you control a planeswalker.", "  PW    Transformative Commons   GU   | This land enters tapped unless you control a planeswalker.", "  PW    Vigorbloom Annex         GW   | This land enters tapped unless you control a planeswalker.", "  SLOW  Deserted Beach           UW   | This land enters tapped unless you control two or more other lands.", "  SLOW  Haunted Ridge            BR   | This land enters tapped unless you control two or more other lands.", "  SLOW  Overgrown Farmland       GW   | This land enters tapped unless you control two or more other lands.", "  SLOW  Rockfall Vale            GR   | This land enters tapped unless you control two or more other lands.", "  SLOW  Shipwreck Marsh          BU   | This land enters tapped unless you control two or more other lands.", "Non-basic lands that do not enter tapped: Eye of Ugin, Hall of Echoes, Hexhaven Dueling Arena", "\nAGG (34): Afterthought Sentry, Avatar of Burgeoning Echoes, Bloodline Recollector, Campus Crier, Carnivorous Cultivator, Chandra's Emberling, Cryotheory Adept, Eardrum Rattler, Edgar, Ancient Bloodlord, Enlightened Confidant, Frostbite Pyromental, Gallia, Tragic Host, Gallia, the Merrymaker, Grim Repriser, Konstrari Improviser, Liliana the Repentant, Marwyn, the Preserver, Master of Barbs, Primal Witchstalker, Proctor of Potential, Proft, Consulting Detective, Proft, Sinister Mastermind, Repurposed Enforcer, Samut, Hazoret's Champion, Samut, Tyrant of Naktamun, Skilled Battlecarver, Solarium Sentry, Stingcaster Mage, Sureshot Sower, Surveillance Phantasm, Tomik, Orzhov Lawmage, Unflinching Hortimancer, Vigorbloom Vanguard, Void Extrapolator", "WALK (41): Academic Ascent, Ajani Resolute, Ajani Unrelenting, Arcane Amphisbaena, Avatar of Burgeoning Echoes, Campus Crier, Chandra, Chill of Compliance, Chandra, Torch of Defiance, Countersculpt, Fatehold Charm, Garruk, Curse Breaker, Garruk, Veiled Butcher, Hexhaven Battalion, Inspired Tethermage, Jace's Machinations, Jace, Reality Sculptor, Keeper of the Quiet Hour, Mindseeker Oculus, No Admittance, Overwrite the Multiverse, Plan for All Outcomes, Protege's Awakening, Repurposed Enforcer, Rewrite Regrets, Sanctum Lurker, Solve for Disappointment, Tam's Resistance, The Theorist, Jace Beleren, Theorist's Proxy, Violent Echoes, Vraska's Final Mercy, Way of the Cryomancer, Way of the Deathbringer, Way of the Healer, Way of the Mentor, Way of the Mind Sculptor, Way of the Necromancer, Way of the Paradox, Way of the Pyromancer, Way of the Warlord, Way of the Wildspeaker", "\nDecks: 10865; Premier 5486; two-colour lane 8301", "\n# B3 deck speed inside a pair\n", "B3 population: 4269 decks (Premier, two-colour lane), 3475 drafts; mc mean 3.06 (pooled within-pair SD 0.283); two-drop share mean 0.370 (within-pair SD 0.086); AGG per deck mean 3.22, SD 1.71", "corr(mc, qA) +0.14; corr(mc, two) -0.54; corr(mc, agg) -0.29", "\n## P1: mean cmc within pair, linear + squared (pts: linear = per +1 SD; ends-minus-middle = squared term, i.e. WR at +-1 SD minus WR at the pair mean)", "  mc linear, Q(a) n=4269             all          +0.19 [-0.51, +0.89] p=0.599", "  mc ends-minus-middle, Q(a)         all          +0.04 [-0.42, +0.50] p=0.874", "  mc linear, Q(a) n=2183             half 0       -0.36 [-1.34, +0.63] p=0.480", "  mc ends-minus-middle, Q(a)         half 0       +0.11 [-0.56, +0.77] p=0.751", "  mc linear, Q(a) n=2086             half 1       +0.80 [-0.21, +1.80] p=0.121", "  mc ends-minus-middle, Q(a)         half 1       -0.03 [-0.67, +0.61] p=0.923", "  mc linear, Q(b) n=4269             all          +0.96 [+0.28, +1.64] p=0.006", "  mc ends-minus-middle, Q(b)         all          -0.06 [-0.52, +0.40] p=0.799", "  mc linear, Q(b) n=2183             half 0       +0.41 [-0.56, +1.39] p=0.403", "  mc ends-minus-middle, Q(b)         half 0       +0.01 [-0.68, +0.70] p=0.980", "  mc linear, Q(b) n=2086             half 1       +1.57 [+0.60, +2.54] p=0.002", "  mc ends-minus-middle, Q(b)         half 1       -0.13 [-0.75, +0.49] p=0.688", "  mc linear, Q(none) n=4269          all          +1.21 [+0.53, +1.89] p=0.000", "  mc ends-minus-middle, Q(none)      all          -0.12 [-0.58, +0.33] p=0.600", "  mc linear, Q(none) n=2183          half 0       +0.68 [-0.28, +1.63] p=0.165", "  mc ends-minus-middle, Q(none)      half 0       -0.04 [-0.70, +0.62] p=0.910", "  mc linear, Q(none) n=2086          half 1       +1.81 [+0.84, +2.79] p=0.0