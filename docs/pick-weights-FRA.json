  "removal": "fills a removal slot the deck still lacks against top players' decks in the pair",
  "card_advantage": "fills a card advantage slot the deck still lacks against top players' decks in the pair",
  "evasion": "fills a evasion slot the deck still lacks against top players' decks in the pair",
  "combat_trick": "fills a combat trick slot the deck still lacks against top players' decks in the pair",
